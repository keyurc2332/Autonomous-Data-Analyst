# ---- App ----
APP_NAME="Autonomous Data Analyst"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---- LLM ----
# Options: google | groq | ollama
LLM_PROVIDER=google

# Google AI Studio (FREE, no credit card): https://aistudio.google.com/apikey
# NEVER enable billing on this project or the free tier disappears.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Groq (FREE, no credit card): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (fully local, unlimited): https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3

# ---- Observability (LangSmith free tier) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=autonomous-data-analyst

# ---- Postgres ----
POSTGRES_USER=ada
POSTGRES_PASSWORD=ada_dev_password
POSTGRES_DB=ada
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---- Storage ----
STORAGE_DIR=/app/storage
MAX_UPLOAD_MB=100
